.env
# Any per-model/per-purpose credentials file (.env_20b, .env_120b, .env_all_keys, etc.) - wildcard
# rather than an explicit list, so a newly created one is covered automatically instead of leaking
# on the next `git add -A` until someone remembers to list it here.
.env_*
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini
.pytest_cache/
AgentAuditor/temp/
CNFinBench/data/
FinVault/data/
embedding_cache_structured/
HIPERGATOR.md
CLAUDE.md
# FinVault converted/derived datasets - large, regenerated locally via
# FinVault/finvault_to_agentauditor.py and FinVault/build_comparison_variants.py, copied to
# HiPerGator directly rather than through git. Covers both the main .json and its .meta.json
# sidecar (which also ends in .json).
AgentAuditor/data/finvault*.json
# All other AgentAuditor/data/*.json and ASSEBench/*.json dataset files - hosted as GitHub Release
# assets instead of git (GitHub blocks Git LFS uploads on public forks, and these run 500KB-21MB
# each). Run `python3 fetch_data.py` after cloning to restore them. fewshot.txt is NOT a dataset
# file and stays tracked normally.
AgentAuditor/data/*.json
ASSEBench/dataset/*.json
ASSEBench/category/*/*.json
# Local pipeline run artifacts (milestone/stdout logs from FinVault/run_finvault_pipeline.sh)
finvault-*_milestones.log
finvault-*_run_stdout.log
# direct_eval's own output + diskcache directories (regenerated locally, not meant for git)
AgentAuditor/direct_temp/
cache/
# Raw HiPerGator eval/timing_summary output collected while building results/PROFILING_RESULTS.md -
# intermediate working artifacts, not polished reports; regenerable via the collect_*.sh scripts
# used to build them. Wildcard rather than an explicit list so a newly pulled-down dump doesn't
# need a new line here.
results/results_*.txt
# Internal Citi meeting decks - confidential, not meant for a public repo. Keep these local/shared
# via Slack, not git.
*.pptx